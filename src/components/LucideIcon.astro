---
interface Props {
  name:
    | 'badge-percent'
    | 'zap'
    | 'shield-check'
    | 'wallet'
    | 'file-check'
    | 'wrench'
    | 'send'
    | 'messages-square'
    | 'phone-call'
    | 'x';
  className?: string;
  strokeWidth?: number;
}

const { name, className = 'h-5 w-5', strokeWidth = 2 } = Astro.props;

const icons = {
  'badge-percent': [
    'M12 3l2.6 2.1 3.3-.4.4 3.3L21 10l-1.7 2.7.4 3.3-3.3.4L14.8 19 12 21l-2.8-2-3.3.4-.4-3.3L3 14l1.7-2.7-.4-3.3 3.3-.4L9.2 5 12 3Z',
    'm9 15 6-6',
    'M9.5 9.5h.01',
    'M14.5 14.5h.01',
  ],
  zap: ['M13 2 3 14h7l-1 8 10-12h-7l1-8Z'],
  'shield-check': ['M12 3l7 4v5c0 5-3.5 8.7-7 10-3.5-1.3-7-5-7-10V7l7-4Z', 'm9 12 2 2 4-4'],
  wallet: [
    'M3 7a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2v1H3V7Z',
    'M3 8h16a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8Z',
    'M16 13h.01',
  ],
  'file-check': [
    'M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z',
    'M14 2v6h6',
    'm9 15 2 2 4-4',
  ],
  wrench: ['M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4L14 13l-3-3 3.7-3.7Z'],
  send: ['M22 2 11 13', 'M22 2 15 22 11 13 2 9 22 2Z'],
  'messages-square': [
    'M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10Z',
    'M7 8h10',
    'M7 12h7',
  ],
  'phone-call': ['M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.4 19.4 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7l.5 3a2 2 0 0 1-.6 1.8l-2 2a16 16 0 0 0 6 6l2-2a2 2 0 0 1 1.8-.6l3 .5a2 2 0 0 1 1.7 2Z', 'M15 3a5 5 0 0 1 5 5', 'M15 7a1 1 0 0 1 1 1'],
  x: ['M18 6 6 18', 'm6 6 12 12'],
} as const;

const paths = icons[name];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-linecap="round"
  stroke-linejoin="round"
  stroke-width={strokeWidth}
  class={className}
  aria-hidden="true"
>
  {paths.map((d) => (
    <path d={d}></path>
  ))}
</svg>
