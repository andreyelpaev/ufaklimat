<script is:inline>
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileLinks = mobileMenu?.querySelectorAll('a');
  const contactModal = document.getElementById('contact-modal');
  const contactTriggers = document.querySelectorAll('[data-contact-modal-trigger]');
  const contactModalClosers = document.querySelectorAll('[data-contact-modal-close]');
  const imageViewer = document.getElementById('image-viewer');
  const imageViewerImg = document.getElementById('image-viewer-img');
  const imageViewerCount = document.getElementById('image-viewer-count');
  const imageViewerTriggers = Array.from(document.querySelectorAll('[data-image-viewer-trigger]'));
  const imageViewerClosers = document.querySelectorAll('[data-image-viewer-close]');
  const imageViewerPrev = document.querySelector('[data-image-viewer-prev]');
  const imageViewerNext = document.querySelector('[data-image-viewer-next]');
  let activeImageIndex = 0;
  let imageViewerTouchStartX = 0;

  const openContactModal = () => {
    if (!contactModal) return;
    contactModal.classList.remove('hidden');
    contactModal.classList.add('flex');
    contactModal.setAttribute('aria-hidden', 'false');
    document.body.classList.add('overflow-hidden');
  };

  const closeContactModal = () => {
    if (!contactModal) return;
    contactModal.classList.add('hidden');
    contactModal.classList.remove('flex');
    contactModal.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('overflow-hidden');
  };

  const setImageViewerImage = (index) => {
    if (!imageViewerImg || !imageViewerTriggers.length) return;

    activeImageIndex = (index + imageViewerTriggers.length) % imageViewerTriggers.length;
    const trigger = imageViewerTriggers[activeImageIndex];
    const src = trigger.getAttribute('data-image-src') || '';
    const alt = trigger.getAttribute('data-image-alt') || '';

    imageViewerImg.setAttribute('src', src);
    imageViewerImg.setAttribute('alt', alt);
    if (imageViewerCount) {
      imageViewerCount.textContent = `${activeImageIndex + 1} / ${imageViewerTriggers.length}`;
    }
  };

  const openImageViewer = (index) => {
    if (!imageViewer || !imageViewerImg) return;
    setImageViewerImage(index);
    imageViewer.classList.remove('hidden');
    imageViewer.classList.add('flex');
    imageViewer.setAttribute('aria-hidden', 'false');
    document.body.classList.add('overflow-hidden');
  };

  const closeImageViewer = () => {
    if (!imageViewer || !imageViewerImg) return;
    imageViewer.classList.add('hidden');
    imageViewer.classList.remove('flex');
    imageViewer.setAttribute('aria-hidden', 'true');
    imageViewerImg.setAttribute('src', '');
    document.body.classList.remove('overflow-hidden');
  };

  const isImageViewerOpen = () => imageViewer?.getAttribute('aria-hidden') === 'false';

  contactTriggers.forEach((trigger) => {
    trigger.addEventListener('click', (event) => {
      event.preventDefault();
      openContactModal();
    });
  });

  contactModalClosers.forEach((closer) => {
    closer.addEventListener('click', closeContactModal);
  });

  imageViewerTriggers.forEach((trigger, index) => {
    trigger.addEventListener('click', () => {
      const imageIndex = Number(trigger.getAttribute('data-image-index') || index);
      openImageViewer(imageIndex);
    });
  });

  imageViewerClosers.forEach((closer) => {
    closer.addEventListener('click', closeImageViewer);
  });

  imageViewerPrev?.addEventListener('click', () => setImageViewerImage(activeImageIndex - 1));
  imageViewerNext?.addEventListener('click', () => setImageViewerImage(activeImageIndex + 1));

  imageViewer?.addEventListener('touchstart', (event) => {
    imageViewerTouchStartX = event.changedTouches[0]?.clientX || 0;
  });

  imageViewer?.addEventListener('touchend', (event) => {
    const touchEndX = event.changedTouches[0]?.clientX || 0;
    const swipeDistance = touchEndX - imageViewerTouchStartX;

    if (Math.abs(swipeDistance) < 50) return;
    setImageViewerImage(activeImageIndex + (swipeDistance > 0 ? -1 : 1));
  });

  menuToggle?.addEventListener('click', () => {
    const expanded = menuToggle.getAttribute('aria-expanded') === 'true';
    menuToggle.setAttribute('aria-expanded', String(!expanded));
    mobileMenu?.classList.toggle('hidden');
  });

  mobileLinks?.forEach((link) => {
    link.addEventListener('click', () => {
      menuToggle?.setAttribute('aria-expanded', 'false');
      mobileMenu?.classList.add('hidden');
    });
  });

  const faqButtons = document.querySelectorAll('.faq-btn');
  faqButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-faq-id');
      const target = document.querySelector(`[data-faq-content="${id}"]`);
      const isOpen = btn.getAttribute('aria-expanded') === 'true';

      faqButtons.forEach((otherBtn) => {
        const otherId = otherBtn.getAttribute('data-faq-id');
        const otherTarget = document.querySelector(`[data-faq-content="${otherId}"]`);
        const sign = otherBtn.querySelector('[data-faq-sign]');
        otherBtn.setAttribute('aria-expanded', 'false');
        otherTarget?.classList.add('hidden');
        if (sign) sign.textContent = '+';
      });

      if (!isOpen) {
        btn.setAttribute('aria-expanded', 'true');
        target?.classList.remove('hidden');
        const sign = btn.querySelector('[data-faq-sign]');
        if (sign) sign.textContent = '−';
      }
    });
  });

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12 }
  );

  document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));

  const year = document.getElementById('year');
  if (year) year.textContent = String(new Date().getFullYear());

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeContactModal();
      closeImageViewer();
    }

    if (!isImageViewerOpen()) return;

    if (event.key === 'ArrowLeft') setImageViewerImage(activeImageIndex - 1);
    if (event.key === 'ArrowRight') setImageViewerImage(activeImageIndex + 1);
  });
</script>
