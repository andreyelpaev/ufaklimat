---
interface Props {
  title?: string;
  accent?: string;
  description?: string;
  centered?: boolean;
  className?: string;
}

const {
  title = '',
  accent = '',
  description,
  centered = true,
  className = '',
} = Astro.props;
---

<div data-reveal class:list={[centered && 'text-center', className]}>
  <h2 class="text-3xl font-semibold md:text-4xl">
    {accent && <b>{accent}</b>}
    {accent && title && ' '}
    {title}
  </h2>
  {description && <p class="mt-3 text-slate-600">{description}</p>}
</div>
