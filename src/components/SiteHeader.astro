---
import LucideIcon from './LucideIcon.astro';
import type { ContactLink, MenuItem } from '../data/site';

interface Props {
  logoSrc: string;
  menu: MenuItem[];
  hours: string;
  phoneHref: string;
  phoneDisplay: string;
  messengers: ContactLink[];
}

const { logoSrc, menu, hours, phoneHref, phoneDisplay, messengers } = Astro.props;

const messengerClass = (label: string) => {
  const normalized = label.toLowerCase();

  if (normalized.includes('whatsapp')) {
    return 'border-emerald-500 bg-emerald-500 text-white shadow-sm hover:border-emerald-600 hover:bg-emerald-600';
  }

  if (normalized.includes('telegram')) {
    return 'border-sky-500 bg-sky-500 text-white shadow-sm hover:border-sky-600 hover:bg-sky-600';
  }

  if (normalized.includes('max')) {
    return 'border-blue-600 bg-blue-600 text-white shadow-sm hover:border-blue-700 hover:bg-blue-700';
  }

  return 'border-slate-200 bg-white text-slate-700 hover:border-brand-400 hover:text-brand-600';
};
---

<header class="sticky top-0 z-50 border-b border-slate-200/70 bg-white backdrop-blur">
  <div class="site-container flex items-center justify-between gap-2 py-4 sm:gap-4">
    <a href="#" class="shrink-0">
      <img src={logoSrc} alt="Логотип" class="h-16 w-auto min-[380px]:h-[84px] min-[480px]:h-24 sm:h-[108px] xl:h-20 2xl:h-24" loading="eager" />
    </a>

    <a
      href={phoneHref}
      class="ml-auto inline-flex h-10 min-w-10 shrink-0 items-center justify-center rounded-lg bg-brand-500 px-2 text-sm font-semibold text-white shadow-soft transition hover:bg-brand-600 min-[560px]:px-3 xl:hidden"
      aria-label={`Позвонить: ${phoneDisplay}`}
    >
      <LucideIcon name="phone-call" className="h-4 w-4 min-[560px]:mr-2" />
      <span class="hidden whitespace-nowrap min-[560px]:inline">{phoneDisplay}</span>
    </a>

    <button
      id="menu-toggle"
      class="shrink-0 rounded-lg border border-slate-300 p-2 xl:hidden"
      aria-label="Открыть меню"
      aria-expanded="false"
    >
      <span class="block h-0.5 w-5 bg-slate-700"></span>
      <span class="mt-1.5 block h-0.5 w-5 bg-slate-700"></span>
      <span class="mt-1.5 block h-0.5 w-5 bg-slate-700"></span>
    </button>

    <nav class="hidden flex-1 xl:block">
      <ul class="flex flex-nowrap items-center justify-center gap-3 text-sm font-semibold text-slate-700 2xl:gap-5">
        {menu.map((item) => (
          <li><a href={item.href} class="whitespace-nowrap transition hover:text-brand-600">{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <a
      href={phoneHref}
      data-contact-modal-trigger
      class="hidden shrink-0 rounded-xl bg-brand-500 px-4 py-2 text-sm font-semibold text-white shadow-soft transition hover:bg-brand-600 xl:inline-flex"
    >
      {phoneDisplay}
    </a>
  </div>

  <div class="border-t border-slate-200 bg-slate-50 xl:hidden">
    <div class="site-container flex items-center justify-center gap-1.5 py-2 text-[11px] font-semibold text-slate-700 min-[380px]:gap-2 min-[380px]:text-xs">
      {messengers.map((item) => (
        <a
          href={item.href}
          target="_blank"
          rel="noopener noreferrer"
          class:list={[
            'rounded-full border px-2.5 py-1.5 transition min-[380px]:px-3',
            messengerClass(item.label),
          ]}
        >
          {item.label}
        </a>
      ))}
    </div>
  </div>

  <div class="hidden border-t border-slate-200 bg-slate-50 xl:block">
    <div class="site-container flex flex-wrap items-center justify-between gap-3 py-2 text-xs text-slate-600">
      <p><a href={phoneHref} class="font-semibold text-slate-700 hover:text-brand-600">{phoneDisplay}</a> • {hours}</p>
      <div class="flex items-center gap-3">
        {messengers.map((item) => (
          <a
            href={item.href}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              'rounded-full border px-3 py-1.5 font-semibold transition',
              messengerClass(item.label),
            ]}
          >
            {item.label}
          </a>
        ))}
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-slate-200 bg-white xl:hidden">
    <div class="site-container py-4">
      <ul class="space-y-2 text-sm font-semibold text-slate-700">
        {menu.map((item) => (
          <li><a href={item.href} class="block rounded-lg px-3 py-2 hover:bg-slate-100">{item.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
</header>
