---
import LucideIcon from '../LucideIcon.astro';
import SectionHeading from '../SectionHeading.astro';
import type { AdvantageItem } from '../../data/site';

interface Props {
  items: AdvantageItem[];
}

const { items } = Astro.props;
---

<section id="reply" class="py-16">
  <div class="site-container">
    <SectionHeading accent="Вы ничем не рискуете" description="Самые комфортные условия для сотрудничества" />
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((item) => (
        <article data-reveal class="rounded-2xl border border-slate-200 bg-white p-5 shadow-soft">
          <div class="inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-50 text-brand-600">
            <LucideIcon name={item.icon} className="h-7 w-7" />
          </div>
          <h3 class="mt-4 text-lg font-semibold">{item.title}</h3>
          <p class="mt-2 text-sm text-slate-600">{item.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
