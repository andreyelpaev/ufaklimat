---
interface Props {
  backgroundImage: string;
  masterImage: string;
  masterName: string;
  masterRole: string;
}

const { backgroundImage, masterImage, masterName, masterRole } = Astro.props;
---

<section id="consultation" class="relative overflow-hidden bg-slate-950 py-16 text-white">
  <div class="landing-orb left-6 top-6 h-40 w-40 bg-cyan-300/20"></div>
  <div class="landing-orb right-[-2rem] bottom-0 h-56 w-56 bg-brand-500/20" style="animation-delay: -6s;"></div>
  <div class="absolute inset-0 bg-[linear-gradient(140deg,_#020617_0%,_#082f49_54%,_#0f172a_100%)]"></div>
  <div class="site-container relative grid gap-8 md:grid-cols-2 md:items-center">
    <div data-reveal class="landing-panel rounded-[2rem] p-5">
      <div class="grid gap-4">
        <img src={masterImage} alt={masterRole} class="h-72 w-full rounded-[1.5rem] object-cover" loading="lazy" />
        <div class="rounded-[1.5rem] border border-white/10 bg-white/5 p-5">
          <p class="text-sm font-semibold uppercase tracking-[0.22em] text-slate-300">{masterName}</p>
          <span class="mt-2 block text-lg font-semibold text-white">{masterRole}</span>
          <p class="mt-3 text-sm leading-6 text-slate-300">
            Без “оставьте заявку и ждите”. Сначала связываемся, уточняем объект и уже после этого предлагаем рабочую схему монтажа.
          </p>
        </div>
      </div>
    </div>
    <div data-reveal>
      <h2 class="text-3xl font-semibold md:text-4xl">
        <span class="headline-gradient">Давайте начнем с консультации</span>
        <span class="block mt-2 accent-underline">и расчета стоимости бесплатно</span>
      </h2>
      <p class="mt-4 max-w-xl text-base leading-7 text-slate-300">
        Обсудим тип системы, ограничения по фасаду, трассе, внутренним блокам и предложим решение без лишнего оборудования и лишних работ.
      </p>
      <form class="mt-6 grid gap-3 rounded-2xl bg-white/10 p-5 backdrop-blur">
        <input
          type="text"
          placeholder="Ваше имя"
          class="rounded-xl border border-white/40 bg-transparent px-4 py-3 text-white placeholder:text-white/70 outline-none"
        />
        <input
          type="tel"
          placeholder="Ваш номер телефона"
          class="rounded-xl border border-white/40 bg-transparent px-4 py-3 text-white placeholder:text-white/70 outline-none"
        />
        <button
          type="button"
          data-contact-modal-trigger
          class="rounded-xl bg-brand-500 px-6 py-3 font-semibold text-white hover:bg-brand-600"
        >
          Перезвоните мне
        </button>
      </form>
    </div>
  </div>
</section>
