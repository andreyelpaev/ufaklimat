---
interface Props {
  backgroundImage: string;
  previewImage: string;
}

const { backgroundImage, previewImage } = Astro.props;
---

<section class="relative overflow-hidden bg-slate-900 py-16 text-white" id="download-price">
  <img src={backgroundImage} alt="" class="absolute inset-0 h-full w-full object-cover opacity-30" />
  <div class="site-container relative grid gap-8 md:grid-cols-2 md:items-center">
    <img data-reveal src={previewImage} alt="Прайс" class="mx-auto w-64 md:w-80" loading="lazy" />
    <div data-reveal>
      <h2 class="text-3xl font-semibold md:text-4xl">
        <b>Скачайте прайс-лист</b> на все услуги в 1 клик
      </h2>
      <form class="mt-6 grid gap-3 rounded-2xl bg-white/10 p-5 backdrop-blur">
        <select class="rounded-xl border border-white/40 bg-transparent px-4 py-3 text-white outline-none">
          <option class="text-slate-900">Получить в WhatsApp</option>
          <option class="text-slate-900">Получить в Telegram</option>
          <option class="text-slate-900">Получить в Viber</option>
        </select>
        <input
          type="tel"
          placeholder="Ваш номер телефона"
          class="rounded-xl border border-white/40 bg-transparent px-4 py-3 text-white placeholder:text-white/70 outline-none"
        />
        <button type="button" class="rounded-xl bg-brand-500 px-6 py-3 font-semibold text-white hover:bg-brand-600">
          Получить прайс сейчас
        </button>
      </form>
    </div>
  </div>
</section>
