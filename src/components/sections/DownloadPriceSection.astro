---
interface Props {
  backgroundImage: string;
}

const { backgroundImage } = Astro.props;
---

<section class="relative overflow-hidden bg-slate-950 py-16 text-white" id="download-price">
  <div class="landing-orb left-10 top-10 h-36 w-36 bg-brand-400/25"></div>
  <div class="landing-orb bottom-4 right-10 h-44 w-44 bg-sky-400/20" style="animation-delay: -5s;"></div>
  <div class="absolute inset-0 bg-[linear-gradient(135deg,_#020617_0%,_#0f172a_60%,_#082f49_100%)]"></div>
  <div class="site-container relative grid gap-8 md:grid-cols-2 md:items-center">
    <div data-reveal class="landing-panel rounded-[2rem] p-8 text-center">
      <div class="mx-auto flex h-16 min-w-16 items-center justify-center rounded-2xl bg-white/10 px-4 text-xs font-semibold uppercase tracking-[0.24em] text-slate-200">
        Честная смета
      </div>
      <div class="mt-6 flex flex-col items-center gap-3">
        <span class="text-4xl font-extrabold text-white md:text-5xl">от 5 000 ₽</span>
        <span class="text-lg font-semibold text-slate-200">монтаж кондиционера</span>
      </div>
      <div class="mt-6 rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-sm leading-6 text-slate-200">
        Ремонт кондиционеров — от 1 000 ₽. Позвоните или напишите в WhatsApp: уточним симптомы, подскажем ближайшее окно и заранее сориентируем по работам.
      </div>
    </div>
    <div data-reveal>
      <h2 class="text-3xl font-semibold md:text-4xl">
        <span class="headline-gradient">Рассчитаем установку или ремонт</span>
        <span class="block mt-2 accent-underline">под ваш объект за 15 минут</span>
      </h2>
      <p class="mt-4 max-w-xl text-base leading-7 text-slate-300">
        Вместо абстрактного прайса уточним модель, доступ к наружному блоку, длину трассы или симптомы поломки, а затем назовем понятную стоимость до начала работ.
      </p>
        <button
          type="button"
          data-contact-modal-trigger
          class="mt-4 inline-flex rounded-xl bg-brand-500 px-6 py-3 font-semibold text-white transition hover:bg-brand-600"
        >
          Узнать стоимость
        </button>
    </div>
  </div>
</section>
