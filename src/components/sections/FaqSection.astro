---
import SectionHeading from '../SectionHeading.astro';
import type { FaqItem } from '../../data/site';

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<section id="faq" class="bg-slate-50 py-16">
  <div class="site-container">
    <div data-reveal class="text-center">
      <h2 class="text-3xl font-semibold md:text-4xl">
        Часто задаваемые <b>вопросы и ответы</b>
      </h2>
    </div>
    <div class="mx-auto mt-8 max-w-4xl space-y-3">
      {items.map((item, index) => (
        <div data-reveal class="rounded-2xl border border-slate-200 bg-white">
          <button
            class="faq-btn flex w-full items-center justify-between gap-3 px-5 py-4 text-left font-semibold"
            data-faq-id={index}
            aria-expanded="false"
          >
            <span>{item.q}</span>
            <span data-faq-sign class="text-brand-600">+</span>
          </button>
          <div class="faq-content hidden border-t border-slate-100 px-5 py-4 text-sm text-slate-600" data-faq-content={index}>
            {item.a}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
