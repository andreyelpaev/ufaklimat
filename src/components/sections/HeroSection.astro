---
interface Props {
  eyebrow: string;
  accent: string;
  accentHighlight: string;
  title: string;
  highlights: string[];
  ctaHref: string;
  ctaLabel: string;
  backgroundImage: string;
  sideImage: string;
}

const { eyebrow, accent, accentHighlight, title, highlights, ctaHref, ctaLabel, backgroundImage, sideImage } = Astro.props;
---

<section class="relative overflow-hidden bg-slate-950 text-white">
  <div class="landing-orb left-[-5rem] top-12 h-44 w-44 bg-brand-500/55"></div>
  <div class="landing-orb right-[-3rem] top-16 h-56 w-56 bg-sky-400/48" style="animation-delay: -4s;"></div>
  <div class="landing-orb bottom-8 left-[38%] h-36 w-36 bg-cyan-300/34" style="animation-delay: -7s;"></div>
  <div class="hero-light-beam left-[-10rem] top-[-12rem] bg-sky-300/36"></div>
  <div class="hero-light-beam right-[-8rem] top-[8%] bg-brand-400/34"></div>
  <div class="hero-core-glow"></div>
  <div class="hero-diagonal-beam"></div>
  <div class="hero-rings"></div>
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_rgba(255,255,255,0.18),_transparent_34%),linear-gradient(135deg,_#020617_0%,_#0b1220_36%,_#082f49_100%)]"></div>
  <div class="absolute inset-0 bg-[linear-gradient(115deg,_transparent_0%,_rgba(255,255,255,0.12)_30%,_transparent_52%)]"></div>
  <div class="hero-lux-grid"></div>
  <div class="hero-lux-noise"></div>
  <div class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-white/25 to-transparent"></div>

  <div class="site-container relative py-16 md:py-24">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1.1fr)_minmax(320px,0.9fr)] lg:items-center">
      <div>
        <span
          data-reveal
          class="kicker-chip inline-flex rounded-full border border-white/15 bg-white/10 px-4 py-2 text-xs font-semibold uppercase tracking-[0.24em] text-white/90"
        >
          {eyebrow}
        </span>
        <h1 data-reveal class="mt-6 max-w-4xl text-4xl font-semibold leading-[1.05] md:text-6xl">
          <span class="headline-gradient block">{accent}</span>
          <span class="mt-2 block accent-underline text-white">{accentHighlight}</span>
          <span class="mt-4 block text-slate-100">{title}</span>
        </h1>
        <p data-reveal class="mt-6 max-w-2xl text-base leading-7 text-slate-300 md:text-lg">
          Работаем с бытовыми и полупромышленными системами под задачу объекта: сначала считаем условия монтажа, потом предлагаем технику и фиксируем стоимость без сюрпризов.
        </p>
        <div data-reveal class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a
            href={ctaHref}
            data-contact-modal-trigger
            class="inline-flex items-center justify-center rounded-xl bg-brand-500 px-6 py-3 font-semibold text-white shadow-soft transition hover:bg-brand-600"
          >
            {ctaLabel}
          </a>
          <a
            href="#products"
            class="inline-flex items-center justify-center rounded-xl border border-white/20 bg-white/5 px-6 py-3 font-semibold text-white transition hover:bg-white/10"
          >
            Посмотреть типы систем
          </a>
        </div>
      </div>

      <div data-reveal class="landing-panel rounded-[2rem] p-5 md:p-6">
        <div class="grid gap-4">
          <div class="flex items-start justify-between gap-4 rounded-[1.5rem] border border-white/10 bg-white/5 p-5">
            <div>
              <p class="text-xs uppercase tracking-[0.24em] text-slate-300">Быстрый старт</p>
              <p class="mt-3 text-4xl font-semibold text-white">3 часа</p>
              <p class="mt-2 max-w-xs text-sm leading-6 text-slate-300">На первичный подбор решения и расчёт под ваш объект.</p>
            </div>
            <div class="stat-card rounded-2xl border border-sky-300/20 bg-sky-400/10 px-4 py-3 text-right">
              <div class="text-xs uppercase tracking-[0.24em] text-sky-100">Centek Air</div>
              <div class="mt-1 text-lg font-semibold text-white">партнер по поставкам</div>
            </div>
          </div>

          <div class="stagger-in grid gap-3 md:grid-cols-3">
            {highlights.map((item) => (
              <div class="rounded-2xl border border-white/10 bg-white/5 p-4 text-sm font-medium leading-6 text-slate-100">
                {item}
              </div>
            ))}
          </div>

          <div class="rounded-[1.5rem] border border-white/10 bg-gradient-to-r from-white/10 to-white/[0.03] p-5">
            <div class="flex flex-wrap items-center gap-3 text-sm text-slate-200">
              <span class="rounded-full bg-white/10 px-3 py-1">Подбор под площадь</span>
              <span class="rounded-full bg-white/10 px-3 py-1">Монтаж в срок</span>
              <span class="rounded-full bg-white/10 px-3 py-1">Сервис после запуска</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
