---
import LucideIcon from '../LucideIcon.astro';
import SectionHeading from '../SectionHeading.astro';

interface Props {
  id?: string;
  accent?: string;
  title?: string;
  images: string[];
  alt: string;
  cardHeightClass: string;
  sectionClass?: string;
}

const {
  id,
  accent = '',
  title = '',
  images,
  alt,
  cardHeightClass,
  sectionClass = 'py-16',
} = Astro.props;
---

<section id={id} class={sectionClass}>
  <div class="site-container">
    <SectionHeading accent={accent} title={title} />
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {images.map((img, index) => (
        <button
          data-reveal
          data-image-viewer-trigger
          data-image-src={img}
          data-image-alt={alt}
          data-image-index={index}
          type="button"
          class="group overflow-hidden rounded-2xl text-left"
        >
          <img
            src={img}
            alt={alt}
            class:list={[cardHeightClass, 'w-full object-cover transition duration-300 group-hover:scale-105']}
            loading="lazy"
          />
        </button>
      ))}
    </div>
  </div>
</section>

<div
  id="image-viewer"
  class="fixed inset-0 z-[90] hidden items-center justify-center bg-slate-950/80 p-4 backdrop-blur-sm"
  aria-hidden="true"
>
  <button
    type="button"
    class="absolute inset-0 cursor-default"
    aria-label="Закрыть изображение"
    data-image-viewer-close
  ></button>
  <div class="relative z-10 max-h-full w-full max-w-6xl">
    <button
      type="button"
      class="absolute right-2 top-2 z-20 inline-flex h-10 w-10 items-center justify-center rounded-full bg-white/90 text-slate-700 shadow-lg transition hover:bg-white hover:text-slate-950"
      aria-label="Закрыть изображение"
      data-image-viewer-close
    >
      <LucideIcon name="x" className="h-5 w-5" />
    </button>
    <button
      type="button"
      class="absolute left-2 top-1/2 z-20 inline-flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/90 text-slate-700 shadow-lg transition hover:bg-white hover:text-slate-950"
      aria-label="Предыдущее изображение"
      data-image-viewer-prev
    >
      <LucideIcon name="chevron-left" className="h-6 w-6" />
    </button>
    <button
      type="button"
      class="absolute right-2 top-1/2 z-20 inline-flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/90 text-slate-700 shadow-lg transition hover:bg-white hover:text-slate-950"
      aria-label="Следующее изображение"
      data-image-viewer-next
    >
      <LucideIcon name="chevron-right" className="h-6 w-6" />
    </button>
    <img
      id="image-viewer-img"
      src=""
      alt=""
      class="mx-auto max-h-[86vh] w-auto max-w-full rounded-lg object-contain shadow-2xl"
    />
    <div
      id="image-viewer-count"
      class="absolute bottom-2 left-1/2 z-20 -translate-x-1/2 rounded-full bg-slate-950/70 px-3 py-1 text-xs font-semibold text-white"
      aria-live="polite"
    ></div>
  </div>
</div>
