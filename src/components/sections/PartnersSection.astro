---
import SectionHeading from '../SectionHeading.astro';
import type { BrandItem } from '../../data/site';

interface Props {
  brands: BrandItem[];
}

const { brands } = Astro.props;
---

<section class="py-16" id="partners">
  <div class="site-container">
    <SectionHeading accent="Предлагаем оптовые цены" title="на кондиционеры Centek Air" />
    <div class="mx-auto mt-8 max-w-3xl">
      {brands.map((brand) => (
        <article
          data-reveal
          class="rounded-[2rem] border border-slate-200 bg-white px-8 py-10 text-center shadow-soft"
        >
          {brand.logo ? (
            <img
              src={brand.logo}
              alt={`${brand.name}${brand.accent ? ` ${brand.accent}` : ''}`}
              class="mx-auto h-16 w-auto object-contain md:h-20"
              loading="lazy"
            />
          ) : (
            <div class="inline-flex flex-col items-center">
              <span class="text-4xl font-extrabold tracking-[0.3em] text-slate-900 md:text-5xl">
                {brand.name}
              </span>
              {brand.accent && (
                <span class="-mt-1 text-2xl font-semibold tracking-[0.55em] text-brand-500 md:text-3xl">
                  {brand.accent}
                </span>
              )}
            </div>
          )}
          {brand.note && <p class="mx-auto mt-5 max-w-xl text-sm text-slate-600 md:text-base">{brand.note}</p>}
        </article>
      ))}
    </div>
  </div>
</section>
