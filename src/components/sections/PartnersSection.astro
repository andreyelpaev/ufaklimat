---
import SectionHeading from '../SectionHeading.astro';
import type { BrandItem } from '../../data/site';

interface Props {
  brands: BrandItem[];
}

const { brands } = Astro.props;
---

<section class="py-16" id="partners">
  <div class="site-container">
    <SectionHeading accent="Работаем с разными производителями" title="и подбираем технику под задачу" />
    <div
      data-reveal
      class="mx-auto mt-8 max-w-5xl rounded-3xl border border-brand-200 bg-white px-6 py-5 text-center shadow-soft md:px-8"
    >
      <p class="text-xs font-semibold uppercase tracking-[0.24em] text-brand-500">Официальные дилеры</p>
      <h3 class="mt-2 text-2xl font-semibold text-slate-900 md:text-3xl">Haier и CENTEK Air</h3>
      <p class="mx-auto mt-3 max-w-3xl text-sm leading-6 text-slate-600 md:text-base">
        Поставляем оригинальное оборудование, помогаем подобрать модель под объект и сохраняем официальную гарантию производителя.
      </p>
    </div>
    <div class="mx-auto mt-8 grid max-w-5xl gap-4 md:grid-cols-2">
      {brands.map((brand) => (
        <article
          data-reveal
          class="flex min-h-64 flex-col items-center justify-center rounded-[2rem] border border-slate-200 bg-white px-8 py-10 text-center shadow-soft"
        >
          {brand.logo ? (
            <img
              src={brand.logo}
              alt={`${brand.name}${brand.accent ? ` ${brand.accent}` : ''}`}
              class="mx-auto h-16 w-auto object-contain md:h-20"
              loading="lazy"
            />
          ) : (
            <div class="inline-flex flex-col items-center">
              <span class="text-4xl font-extrabold text-slate-900 md:text-5xl">
                {brand.name}
              </span>
              {brand.accent && (
                <span class="-mt-1 text-2xl font-semibold tracking-[0.55em] text-brand-500 md:text-3xl">
                  {brand.accent}
                </span>
              )}
            </div>
          )}
          {brand.note && <p class="mx-auto mt-5 max-w-xl text-sm text-slate-600 md:text-base">{brand.note}</p>}
        </article>
      ))}
    </div>
  </div>
</section>
