---
import SectionHeading from '../SectionHeading.astro';

interface Props {
  logos: string[];
}

const { logos } = Astro.props;
---

<section class="py-16" id="partners">
  <div class="site-container">
    <SectionHeading accent="Предлагаем оптовые цены" title="на кондиционеры от надежных брендов" />
    <div class="mt-8 grid grid-cols-2 gap-4 md:grid-cols-4 lg:grid-cols-7">
      {logos.map((img) => (
        <div data-reveal class="rounded-2xl border border-slate-200 bg-white p-3 shadow-soft">
          <img src={img} alt="Бренд" class="h-16 w-full object-contain" loading="lazy" />
        </div>
      ))}
    </div>
  </div>
</section>
