---
import SectionHeading from '../SectionHeading.astro';
import type { ProductItem } from '../../data/site';

interface Props {
  items: ProductItem[];
}

const { items } = Astro.props;
---

<section id="products" class="bg-slate-50 py-16">
  <div class="site-container">
    <SectionHeading accent="Самые популярные модели" title="кондиционеров для квартиры" />
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {items.map((item) => (
        <article data-reveal class="rounded-3xl bg-white p-4 shadow-soft transition hover:-translate-y-1 hover:shadow-2xl">
          <img src={item.image} alt={item.name} class="h-52 w-full rounded-2xl object-cover" loading="lazy" />
          <h3 class="mt-4 text-base font-semibold">{item.name}</h3>
          <div class="mt-2 flex items-center gap-2">
            <span class="text-lg font-bold text-brand-600">{item.current}</span>
            <span class="text-sm text-slate-400 line-through">{item.old}</span>
          </div>
          <button
            type="button"
            class="mt-4 w-full rounded-xl border border-brand-500 px-4 py-3 font-semibold text-brand-600 transition hover:bg-brand-500 hover:text-white"
          >
            Заказать в 1 клик
          </button>
        </article>
      ))}
    </div>
  </div>
</section>
