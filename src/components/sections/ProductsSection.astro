---
import SectionHeading from '../SectionHeading.astro';
import type { ProductItem } from '../../data/site';

interface Props {
  items: ProductItem[];
}

const { items } = Astro.props;
---

<section id="products" class="bg-slate-50 py-16">
  <div class="site-container">
    <SectionHeading accent="Любые бренды" title="под разные задачи монтажа и ремонта" />
    <div class="mt-10 grid gap-6 lg:grid-cols-2">
      {items.map((item) => (
        <article data-reveal class="rounded-3xl bg-white p-4 shadow-soft transition hover:-translate-y-1 hover:shadow-2xl">
          <div class="rounded-2xl bg-slate-50 p-4">
            <img src={item.image} alt={item.name} class="h-52 w-full object-contain" loading="lazy" />
          </div>
          <h3 class="mt-4 text-xl font-semibold">{item.name}</h3>
          <p class="mt-2 text-sm text-slate-600">{item.description}</p>
          <p class="mt-3 text-sm font-medium text-slate-800">{item.details}</p>
          <a
            href={item.href}
            data-contact-modal-trigger
            class="mt-4 inline-flex w-full items-center justify-center rounded-xl border border-brand-500 px-4 py-3 font-semibold text-brand-600 transition hover:bg-brand-500 hover:text-white"
          >
            Позвонить или написать
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
