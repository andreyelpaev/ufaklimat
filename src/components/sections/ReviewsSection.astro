---
import SectionHeading from '../SectionHeading.astro';
import type { ReviewItem } from '../../data/site';

interface Props {
  items: ReviewItem[];
}

const { items } = Astro.props;
---

<section id="otziv" class="py-16">
  <div class="site-container">
    <SectionHeading accent="Отзывы" title="наших клиентов" />
    <div class="mt-8 grid gap-6 lg:grid-cols-2">
      {items.map((review) => (
        <article data-reveal class="rounded-3xl border border-slate-200 bg-white p-6 shadow-soft">
          <div class="flex items-center gap-4">
            <img src={review.avatar} alt={review.name} class="h-14 w-14 rounded-full object-cover" loading="lazy" />
            <div>
              <div class="text-lg font-semibold">{review.name}</div>
              <div class="text-sm text-slate-500">{review.city}</div>
            </div>
          </div>
          <p class="mt-4 text-slate-700">{review.text}</p>
          <div class="mt-4 grid grid-cols-2 gap-3">
            {review.photos.map((photo) => (
              <img src={photo} alt="Фото объекта" class="h-32 w-full rounded-xl object-cover" loading="lazy" />
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
