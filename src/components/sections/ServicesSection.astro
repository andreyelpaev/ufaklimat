---
import SectionHeading from '../SectionHeading.astro';
import type { ServiceItem } from '../../data/site';

interface Props {
  items: ServiceItem[];
}

const { items } = Astro.props;
---

<section id="deadlines" class="py-16">
  <div class="site-container">
    <SectionHeading accent="Наши услуги" />
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {items.map((item) => (
        <article
          data-reveal
          class="rounded-3xl border border-slate-200 bg-white p-4 shadow-soft transition hover:-translate-y-1 hover:shadow-2xl"
        >
          <img src={item.image} alt={item.title} class="h-48 w-full rounded-2xl object-cover" loading="lazy" />
          <h3 class="mt-4 text-xl font-semibold">{item.title}</h3>
          <p class="mt-2 text-sm text-slate-600">{item.text}</p>
          <button
            type="button"
            data-contact-modal-trigger
            class="mt-4 w-full rounded-xl bg-brand-500 px-4 py-3 font-semibold text-white hover:bg-brand-600"
          >
            Оставить заявку
          </button>
        </article>
      ))}
    </div>
  </div>
</section>
