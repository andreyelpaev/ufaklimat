---
import ContactsNote from '../content/text/contacts-note.mdx';
import CompanyContent from '../content/text/company.mdx';
import ContactModal from '../components/ContactModal.astro';
import FloatingActions from '../components/FloatingActions.astro';
import PageScripts from '../components/PageScripts.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import AdvantagesSection from '../components/sections/AdvantagesSection.astro';
import ConsultationSection from '../components/sections/ConsultationSection.astro';
import ContactsSection from '../components/sections/ContactsSection.astro';
import DownloadPriceSection from '../components/sections/DownloadPriceSection.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import ImageGallerySection from '../components/sections/ImageGallerySection.astro';
import PartnersSection from '../components/sections/PartnersSection.astro';
import ProductsSection from '../components/sections/ProductsSection.astro';
import PromotionsSection from '../components/sections/PromotionsSection.astro';
import QuizSection from '../components/sections/QuizSection.astro';
import ReviewsSection from '../components/sections/ReviewsSection.astro';
import RichTextSection from '../components/sections/RichTextSection.astro';
import ServicesSection from '../components/sections/ServicesSection.astro';
import {
  advantages,
  certificates,
  companyInfo,
  contactModal,
  consultationLead,
  contactsCard,
  faq,
  hero,
  menu,
  messengerLinks,
  partnerBrands,
  portfolio,
  priceLead,
  products,
  promotions,
  reviews,
  services,
  siteMeta,
} from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title={siteMeta.title}>
  <SiteHeader
    logoSrc={companyInfo.logo}
    menu={menu}
    address={companyInfo.address}
    hours={companyInfo.hours}
    phoneHref={companyInfo.phoneHref}
    phoneDisplay={companyInfo.phoneDisplay}
    messengers={messengerLinks}
  />

  <main>
    <HeroSection {...hero} />
    <ServicesSection items={services} />
    <ProductsSection items={products} />
    <PartnersSection brands={partnerBrands} />
    <DownloadPriceSection {...priceLead} />
    <ImageGallerySection
      id="process"
      sectionClass="bg-slate-50 py-16"
      accent="Посмотрите последние"
      title="наши работы"
      images={portfolio}
      alt="Работа"
      cardHeightClass="h-52"
    />

    <AdvantagesSection items={advantages} />
    <FaqSection items={faq} />
    <PromotionsSection items={promotions} />
    <RichTextSection
      id="kompanya"
      sectionClass="bg-grid py-16"
      title="Компания по монтажу и продаже кондиционеров в Уфе и Башкортостане"
      Content={CompanyContent}
    />
    <ContactsSection
      address={companyInfo.address}
      hours={companyInfo.hours}
      phoneDisplay={companyInfo.phoneDisplay}
      phoneHref={companyInfo.phoneHref}
      email={companyInfo.email}
      requisitesUrl={contactsCard.requisitesUrl}
      officePhotos={contactsCard.officePhotos}
      mapEmbedUrl={contactsCard.mapEmbedUrl}
      socialLinks={contactsCard.socialLinks}
      NoteContent={ContactsNote}
    />
  </main>

  <ContactModal contact={contactModal} />
  <SiteFooter inn={companyInfo.inn} ogrn={companyInfo.ogrn} />
  <PageScripts />
</BaseLayout>
